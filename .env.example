# Sentinel Environment Template
# Copy to .env and fill in values. Never commit real secrets.

NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Control plane API
API_HOST=0.0.0.0
API_PORT=3001

# API Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3000

# Demo upstream service
DEMO_SERVICE_HOST=0.0.0.0
DEMO_SERVICE_PORT=3002

# Auth (generate strong random values for local use)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Logging
LOG_LEVEL=info

# AI
AI_PROVIDER=heuristic
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# AI
AI_PROVIDER=heuristic
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
